{
  "name": "CryptoWallet",
  "type": "object",
  "properties": {
    "user_profile_id": {
      "type": "string",
      "description": "ID of the user profile this wallet belongs to"
    },
    "blockchain": {
      "type": "string",
      "description": "Blockchain network (e.g., Ethereum, Bitcoin, Solana)",
      "enum": [
        "ethereum",
        "bitcoin",
        "solana",
        "polygon",
        "avalanche",
        "binance_smart_chain",
        "other"
      ]
    },
    "other_blockchain": {
      "type": "string",
      "description": "Custom blockchain name if 'other' is selected",
      "nullable": true
    },
    "public_key": {
      "type": "string",
      "description": "Public wallet address/key"
    },
    "wallet_name": {
      "type": "string",
      "description": "Optional name for the wallet (e.g., 'My ETH Wallet')",
      "nullable": true
    },
    "is_primary": {
      "type": "boolean",
      "description": "Whether this is the primary crypto wallet",
      "default": false
    }
  },
  "required": [
    "user_profile_id",
    "blockchain",
    "public_key"
  ]
}

