{
  "name": "BankAccount",
  "type": "object",
  "properties": {
    "user_profile_id": {
      "type": "string",
      "description": "ID of the user profile this account belongs to"
    },
    "bank_name": {
      "type": "string",
      "description": "Name of the bank"
    },
    "account_number": {
      "type": "string",
      "description": "Bank account number"
    },
    "routing_number": {
      "type": "string",
      "description": "Bank routing number for US accounts",
      "nullable": true
    },
    "iban": {
      "type": "string",
      "description": "International Bank Account Number for non-US accounts",
      "nullable": true
    },
    "swift_code": {
      "type": "string",
      "description": "SWIFT/BIC code for international transfers",
      "nullable": true
    },
    "country": {
      "type": "string",
      "description": "Country where the bank account is located"
    },
    "account_holder_name": {
      "type": "string",
      "description": "Name of the account holder"
    },
    "is_primary": {
      "type": "boolean",
      "description": "Whether this is the primary bank account",
      "default": false
    }
  },
  "required": [
    "user_profile_id",
    "bank_name",
    "account_number",
    "country",
    "account_holder_name"
  ]
}

