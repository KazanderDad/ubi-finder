{
  "name": "ProgramManager",
  "type": "object",
  "properties": {
    "program_id": {
      "type": "integer",
      "description": "ID of the program this record refers to"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the user with access"
    },
    "user_profile_id": {
      "type": "string",
      "description": "ID of the user profile"
    },
    "role": {
      "type": "string",
      "enum": [
        "owner",
        "admin"
      ],
      "description": "Access level for this program"
    },
    "is_favorite": {
      "type": "boolean",
      "description": "Whether the user has favorited this program",
      "default": false
    },
    "added_date": {
      "type": "string",
      "format": "date-time",
      "description": "When access was granted"
    }
  },
  "required": [
    "program_id",
    "user_email",
    "user_profile_id",
    "role"
  ]
}

