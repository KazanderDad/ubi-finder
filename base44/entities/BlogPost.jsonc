{
  "name": "BlogPost",
  "type": "object",
  "properties": {
    "title": {
      "type": "string",
      "description": "Title of the blog post"
    },
    "content": {
      "type": "string",
      "description": "Main content of the blog post in markdown format"
    },
    "summary": {
      "type": "string",
      "description": "Short summary of the post"
    },
    "author": {
      "type": "string",
      "description": "Name of the author"
    },
    "posted_date": {
      "type": "string",
      "format": "date-time",
      "description": "When the post was published"
    },
    "image_url": {
      "type": "string",
      "description": "Featured image URL",
      "nullable": true
    },
    "related_programs": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of program IDs this post relates to",
      "nullable": true
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Array of tag strings",
      "nullable": true
    }
  },
  "required": [
    "title",
    "content",
    "author",
    "posted_date"
  ]
}

